@@ -0,0 +1,23 @@
+name: Setup Python
+description: Install the pinned uv, Python 3.13, and the locked dev and fetch groups. Not the GPU stack.
+
+runs:
+  using: composite
+  steps:
+    - name: Install uv
+      uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
+      with:
+        # Keep in sync with the uv-pre-commit rev in .pre-commit-config.yaml.
+        version: "0.13.4"
+        enable-cache: true
+
+    - name: Set up Python
+      shell: bash
+      run: uv python install
+
+    - name: Install dependencies
+      shell: bash
+      # Only the dev and fetch groups. The project dependencies are the GPU training stack
+      # (torch, Unsloth): several GB, and the runners have no GPU. The tests import the
+      # package from src/ (pythonpath in pyproject.toml).
+      run: uv sync --locked --only-group dev --only-group fetch
diff --git a/.github/dependabot.yml b/.github/dependabot.yml
new file mode 100644
index 0000000000000000000000000000000000000000..a93cb3215aee138456ee385fac9801ccda309165
--- /dev/null
+++ b/.github/dependabot.yml
@@ -0,0 +1,60 @@
+version: 2
+updates:
+  - package-ecosystem: "github-actions"
+    directories:
+      - "/"
+      - "/.github/actions/setup"
+    schedule:
+      interval: "weekly"
+    commit-message:
+      prefix: "CI"
+    cooldown:
+      default-days: 7
+    groups:
+      github-actions:
+        patterns:
+          - "*"
+
+  - package-ecosystem: "pre-commit"
+    directory: "/"
+    schedule:
+      interval: "weekly"
+    commit-message:
+      prefix: "CI"
+    cooldown:
+      default-days: 7
+    ignore:
+      # This rev is the uv release CI pins by hand. Bump both manually.
+      - dependency-name: "https://github.com/astral-sh/uv-pre-commit"
+    groups:
+      pre-commit-hooks:
+        patterns:
+          - "*"
+
+  - package-ecosystem: "uv"
+    directory: "/"
+    schedule:
+      interval: "weekly"
+    commit-message:
+      prefix: "build"
+      include: "scope"
+    cooldown:
+      default-days: 7
+    ignore:
+      # The GPU training stack is pinned to the combination that ran on the RTX 2060. CI has no
+      # GPU, so it cannot test an update. Update these packages by hand, and test on a GPU.
+      - dependency-name: "accelerate"
+      - dependency-name: "bitsandbytes"
+      - dependency-name: "datasets"
+      - dependency-name: "peft"
+      - dependency-name: "torch"
+      - dependency-name: "torchao"
+      - dependency-name: "transformers"
+      - dependency-name: "trl"
+      - dependency-name: "unsloth"
+      - dependency-name: "unsloth-zoo"
+    groups:
+      uv-minor-patch:
+        update-types:
+          - "minor"
+          - "patch"
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
index 0000000000000000000000000000000000000000..82de96c5a6c06809e15646f1fe255ef3142a8c21
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,97 @@
+name: GitHub CI
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.head_ref || github.sha }}
+  cancel-in-progress: true
+
+permissions:
+  contents: read # to fetch code (actions/checkout)
+
+env:
+  # The setup action installs only the dev and fetch groups. Without this, each `uv run` would
+  # first install the full GPU training stack.
+  UV_NO_SYNC: "1"
+
+jobs:
+  lint:
+    name: Lint and format
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+
+      - name: Setup Python
+        uses: ./.github/actions/setup
+
+      - name: Ruff lint
+        run: uv run ruff check .
+
+      - name: Ruff format
+        run: uv run ruff format --check .
+
+      # The same hooks as in .pre-commit-config.yaml. A person can skip the local hooks.
+      - name: No client data or model weights in git
+        run: uv run pre-commit run no-client-data --all-files
+
+      - name: No tokens or private keys in git
+        run: uv run pre-commit run no-secrets --all-files
+
+  typecheck:
+    name: Type check
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+
+      - name: Setup Python
+        uses: ./.github/actions/setup
+
+      - name: mypy
+        run: uv run mypy
+
+  test-unit:
+    name: Unit tests (${{ matrix.os }})
+    runs-on: ${{ matrix.os }}
+    continue-on-error: ${{ matrix.os != 'ubuntu-latest' }} # Win64/Ubuntu arm failure wont fail run for Ubuntu x64
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-latest, ubuntu-26.04-arm, windows-latest]
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+
+      - name: Setup Python
+        uses: ./.github/actions/setup
+
+      # The browser tests skip here: BIOPARSER_CHROMIUM is not set.
+      - name: Run unit tests
+        run: uv run pytest
+
+  test-browser:
+    name: Browser tests
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+
+      - name: Setup Python
+        uses: ./.github/actions/setup
+
+      - name: Install Chromium
+        run: uv run playwright install --with-deps chromium
+
+      - name: Run the fetch tests with Chromium
+        run: |
+          BIOPARSER_CHROMIUM="$(uv run python -c 'from playwright.sync_api import sync_playwright as s; p = s().start(); print(p.chromium.executable_path); p.stop()')"
+          export BIOPARSER_CHROMIUM
+          uv run pytest tests/test_fetch.py
